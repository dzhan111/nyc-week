{
  "name": "nyc-week",
  "private": true,
  "type": "module",
  "description": "Weekly NYC events, researched automatically and published to GitHub Pages.",
  "scripts": {
    "build": "node site/build.mjs",
    "build:fixture": "node site/build.mjs --data data/fixtures",
    "serve": "python3 -m http.server 8231 --directory dist",
    "research": "node scripts/fetch-week.mjs",
    "research:dry": "node scripts/fetch-week.mjs --dry-run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0"
  },
  "engines": { "node": ">=20" }
}
